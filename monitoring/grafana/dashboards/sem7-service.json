   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(http_server_request_duration_count{service_name=\"sem7-api\", http_response_status_code=~\"5..\"}[5m])) or vector(0)",
     "legendFormat": "5xx"
