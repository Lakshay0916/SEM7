  {
   "type": "row",
   "title": "API (FastAPI instrumentation)",
   "collapsed": false,
   "panels": [],
   "gridPos": {
    "x": 0,
    "y": 13,
    "w": 24,
    "h": 1
   }
  },
  {
   "type": "timeseries",
   "title": "Requests per second by route",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (http_route) (rate(http_server_request_duration_count{service_name=\"sem7-api\"}[5m]))",
     "legendFormat": "{{http_route}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "id": 9,
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 12,
    "h": 8
   }
  },
  {
   "type": "timeseries",
   "title": "Latency p95 by route",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, http_route) (rate(http_server_request_duration_bucket{service_name=\"sem7-api\"}[5m])))",
     "legendFormat": "{{http_route}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "id": 10,
   "gridPos": {
    "x": 12,
    "y": 14,
    "w": 12,
    "h": 8
   }
  },
  {
   "type": "timeseries",
