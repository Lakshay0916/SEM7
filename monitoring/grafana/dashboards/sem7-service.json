{
 "uid": "sem7-service",
 "title": "SEM7 \u00b7 Service & workflows",
 "description": "The API and the self-healing workflows: requests, latency, outcomes, guardrails, service map.",
 "tags": [
  "sem7"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "panels": [
  {
   "type": "row",
   "title": "Workflows since the service started",
   "collapsed": false,
   "panels": [],
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   }
  },
  {
   "type": "stat",
   "title": "Workflows finished",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(sem7_workflows)",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "color": {
      "mode": "fixed",
      "fixedColor": "blue"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   },
   "id": 2,
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 6,
    "h": 4
   }
  },
  {
   "type": "stat",
   "title": "Fixed (PR created)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "100 * sum(sem7_workflows{outcome=\"pr_created\"} or vector(0)) / clamp_min(sum(sem7_workflows), 1)",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "color": {
      "mode": "fixed",
      "fixedColor": "blue"
     },
     "decimals": 0
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   },
   "id": 3,
   "gridPos": {
    "x": 6,
    "y": 1,
    "w": 6,
    "h": 4
   }
  },
  {
   "type": "stat",
   "title": "Avg repair attempts",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(sem7_repair_attempts_sum) / clamp_min(sum(sem7_repair_attempts_count), 1)",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "color": {
      "mode": "fixed",
      "fixedColor": "blue"
     },
     "decimals": 2
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   },
   "id": 4,
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 6,
    "h": 4
   }
  },
  {
   "type": "stat",
   "title": "Guardrail blocks",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(sem7_guardrail_verdicts{action=\"block\"} or vector(0))",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "color": {
      "mode": "fixed",
      "fixedColor": "blue"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   },
   "id": 5,
   "gridPos": {
    "x": 18,
    "y": 1,
    "w": 6,
    "h": 4
   }
  },
  {
   "type": "bargauge",
   "title": "Workflows by outcome, strategy and pattern",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (outcome, strategy, pattern) (sem7_workflows)",
     "legendFormat": "{{outcome}} \u00b7 {{strategy}} \u00b7 {{pattern}}",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "color": {
      "mode": "fixed",
      "fixedColor": "blue"
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "basic",
    "showUnfilled": true,
    "valueMode": "text",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "id": 6,
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 12,
    "h": 8
   }
  },
  {
   "type": "bargauge",
   "title": "Input-guardrail verdicts",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (context, action) (sem7_guardrail_verdicts)",
     "legendFormat": "{{context}} \u00b7 {{action}}",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "color": {
      "mode": "fixed",
      "fixedColor": "blue"
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "basic",
