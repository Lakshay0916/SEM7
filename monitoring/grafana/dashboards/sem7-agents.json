  {
   "type": "stat",
   "title": "Failed LLM calls",
   "description": "Mostly the free tier's rate limit (429).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "100 * sum(sem7_llm_errors or vector(0)) / clamp_min(sum(sem7_llm_calls), 1)",
     "instant": true
