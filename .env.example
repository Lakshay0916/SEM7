# Copy to .env and fill in. Never commit .env.

# LLM provider: "heuristic" (offline, rule-based, deterministic) or "anthropic"
# Used by the project assistant (chatbot); with "anthropic" set LLM_API_KEY to an Anthropic API key.
LLM_PROVIDER=heuristic
LLM_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium

# Self-healing analysis: "rules" (deterministic default, used by CI) or "agents" (Google ADK + CrewAI on Gemini).
# Agents need requirements-agents.txt and a Gemini key (https://aistudio.google.com/apikey).
REPAIR_STRATEGY=rules
AGENT_MODEL=gemini-3.1-flash-lite
AGENT_FALLBACK=1
GOOGLE_API_KEY=
GEMINI_API_KEY=

# GitHub (optional; a local/mock PR adapter is used when unset)
GITHUB_TOKEN=
REPOSITORY_URL=

# Runtime
WORKSPACE_DIR=workspace
DATABASE_URL=sqlite:///workspace/sem7.sqlite3
TEST_TIMEOUT_SECONDS=60
MAX_REPAIR_ATTEMPTS=3

# PostgreSQL (docker compose). Change the password for anything beyond local use.
POSTGRES_USER=sem7
POSTGRES_PASSWORD=sem7dev
POSTGRES_DB=sem7

# UI → API address (local runs; compose sets this automatically)
SEM7_API_URL=http://localhost:8000

# Host ports published by docker compose
API_PORT=8000
UI_PORT=8502
